{
  "name": "scope-gopher",
  "displayName": "Scope Gopher",
  "description": "Make exported and unexported Go declarations visible in the editor.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "golang.go"
  ],
  "contributes": {
    "configuration": {
      "title": "Scope Gopher",
      "properties": {
        "scopeGopher.highlighting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Scope Gopher declaration highlighting."
        },
        "scopeGopher.highlighting.exportedColor": {
          "type": "string",
          "default": "#4EC9B0",
          "description": "Foreground color for exported declarations."
        },
        "scopeGopher.highlighting.unexportedColor": {
          "type": "string",
          "default": "#C586C0",
          "description": "Foreground color for unexported declarations."
        },
        "scopeGopher.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Scope Gopher inlay hints."
        },
        "scopeGopher.inlayHints.exportedLabel": {
          "type": "string",
          "default": "exported",
          "description": "Inlay hint label for exported declarations."
        },
        "scopeGopher.inlayHints.unexportedLabel": {
          "type": "string",
          "default": "unexported",
          "description": "Inlay hint label for unexported declarations."
        },
        "scopeGopher.enabledDeclarationKinds": {
          "type": "array",
          "default": [
            "function",
            "method"
          ],
          "items": {
            "type": "string",
            "enum": [
              "function",
              "method",
              "interfaceMethod",
              "struct",
              "interface",
              "type",
              "field",
              "variable",
              "constant"
            ]
          },
          "uniqueItems": true,
          "description": "Declaration kinds that Scope Gopher marks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.116.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}